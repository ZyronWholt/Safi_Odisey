[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://login.gd" id="1_login"]

[node name="Login" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_login")

[node name="Fondo" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.08, 0.12, 0.18, 1)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -180.0
offset_top = -190.0
offset_right = 180.0
offset_bottom = 190.0
grow_horizontal = 2
grow_vertical = 2

[node name="Contenido" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="Titulo" type="Label" parent="Panel/Contenido"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Safi Odisey"
horizontal_alignment = 1

[node name="Subtitulo" type="Label" parent="Panel/Contenido"]
layout_mode = 2
text = "Inicio de sesión"
horizontal_alignment = 1

[node name="SeparadorSuperior" type="Control" parent="Panel/Contenido"]
custom_minimum_size = Vector2(0, 8)
layout_mode = 2

[node name="EtiquetaCorreo" type="Label" parent="Panel/Contenido"]
layout_mode = 2
text = "Correo electrónico"

[node name="input_email" type="LineEdit" parent="Panel/Contenido"]
layout_mode = 2
custom_minimum_size = Vector2(280, 38)
placeholder_text = "tu@correo.com"

[node name="EtiquetaContrasena" type="Label" parent="Panel/Contenido"]
layout_mode = 2
text = "Contraseña"

[node name="input_password" type="LineEdit" parent="Panel/Contenido"]
layout_mode = 2
custom_minimum_size = Vector2(280, 38)
placeholder_text = "Ingresa tu contraseña"
secret = true

[node name="SeparadorInferior" type="Control" parent="Panel/Contenido"]
custom_minimum_size = Vector2(0, 4)
layout_mode = 2

[node name="lbl_message" type="Label" parent="Panel/Contenido"]
layout_mode = 2
text = ""
horizontal_alignment = 1
autowrap_mode = 3

[node name="btn_login" type="Button" parent="Panel/Contenido"]
layout_mode = 2
custom_minimum_size = Vector2(280, 42)
text = "Iniciar sesión"

[node name="btn_forgot_password" type="Button" parent="Panel/Contenido"]
layout_mode = 2
custom_minimum_size = Vector2(280, 38)
text = "¿Olvidaste tu contraseña?"

[node name="btn_google_login" type="Button" parent="Panel/Contenido"]
layout_mode = 2
custom_minimum_size = Vector2(280, 42)
text = "G  Iniciar sesión con Google"

[node name="btn_go_to_register" type="Button" parent="Panel/Contenido"]
layout_mode = 2
custom_minimum_size = Vector2(280, 42)
text = "¿No tienes cuenta? Regístrate"

[connection signal="pressed" from="Panel/Contenido/btn_login" to="." method="_on_login_pressed"]
[connection signal="pressed" from="Panel/Contenido/btn_forgot_password" to="." method="_on_forgot_password_pressed"]
[connection signal="pressed" from="Panel/Contenido/btn_google_login" to="." method="_on_google_login_pressed"]
[connection signal="pressed" from="Panel/Contenido/btn_go_to_register" to="." method="_on_go_to_register_pressed"]
