[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://login.gd" id="1_login"]

[node name="Login" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_login")

[node name="Fondo" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.08, 0.12, 0.18, 1)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -180.0
offset_top = -190.0
offset_right = 180.0
offset_bottom = 190.0
grow_horizontal = 2
grow_vertical = 2

[node name="Contenido" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="Titulo" type="Label" parent="Panel/Contenido"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Safi Odisey"
horizontal_alignment = 1

[node name="Subtitulo" type="Label" parent="Panel/Contenido"]
layout_mode = 2
text = "Inicio de sesión"
horizontal_alignment = 1

[node name="SeparadorSuperior" type="Control" parent="Panel/Contenido"]
custom_minimum_size = Vector2(0, 8)
layout_mode = 2

[node name="EtiquetaUsuario" type="Label" parent="Panel/Contenido"]
layout_mode = 2
text = "Usuario"

[node name="Usuario" type="LineEdit" parent="Panel/Contenido"]
layout_mode = 2
custom_minimum_size = Vector2(280, 38)
placeholder_text = "Ingresa tu usuario"

[node name="EtiquetaContrasena" type="Label" parent="Panel/Contenido"]
layout_mode = 2
text = "Contraseña"

[node name="Contrasena" type="LineEdit" parent="Panel/Contenido"]
layout_mode = 2
custom_minimum_size = Vector2(280, 38)
placeholder_text = "Ingresa tu contraseña"
secret = true

[node name="SeparadorInferior" type="Control" parent="Panel/Contenido"]
custom_minimum_size = Vector2(0, 4)
layout_mode = 2

[node name="IniciarSesion" type="Button" parent="Panel/Contenido"]
layout_mode = 2
custom_minimum_size = Vector2(280, 42)
text = "Iniciar sesión"

[node name="CrearCuenta" type="Button" parent="Panel/Contenido"]
layout_mode = 2
custom_minimum_size = Vector2(280, 42)
text = "Crear una cuenta"

[connection signal="pressed" from="Panel/Contenido/IniciarSesion" to="." method="_on_login_pressed"]
[connection signal="pressed" from="Panel/Contenido/CrearCuenta" to="." method="_on_create_account_pressed"]
